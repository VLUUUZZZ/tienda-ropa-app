rules_version = '2';

// Each store (tiendas/{tiendaId}) is isolated: its catalog and its staff are
// only visible to its own members. Roles live in usuarios/{uid}:
// - admin:    everything in their store, including managing its accounts.
// - empleado: read their store's catalog and change stock counts only.
// Anyone may open a new store, and becomes the admin of that store only.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function ownProfilePath() {
      return /databases/$(database)/documents/usuarios/$(request.auth.uid);
    }

    function storePath(tiendaId) {
      return /databases/$(database)/documents/tiendas/$(tiendaId);
    }

    function profile() {
      return get(ownProfilePath()).data;
    }

    function isMemberOf(tiendaId) {
      return signedIn()
        && exists(ownProfilePath())
        && profile().activo == true
        && profile().tiendaId == tiendaId;
    }

    function isAdminOf(tiendaId) {
      return isMemberOf(tiendaId) && profile().rol == 'admin';
    }

    function isValidProfile(data) {
      return data.keys().hasOnly(
          ['nombre', 'correo', 'rol', 'activo', 'tiendaId', 'tiendaNombre', 'creado'])
        && data.nombre is string && data.nombre.size() > 0
        && data.correo is string
        && data.rol in ['admin', 'empleado']
        && data.activo is bool
        && data.tiendaId is string
        && data.tiendaNombre is string;
    }

    // A garment as the app writes it (see ClothingItem.toMap and Limites in
    // lib/models/clothing_item.dart; the name limit here is looser so older
    // garments stay editable). Rules can't loop over the variants, so
    // each one's fields are checked by the app; here, the shape and bounds.
    function isValidPrenda(prendaId, data) {
      return data.keys().hasOnly(
          ['id', 'nombre', 'precio', 'variantes', 'codigoProveedor', 'actualizado'])
        && data.id == prendaId
        && (!('codigoProveedor' in data) || data.codigoProveedor is string)
        && data.nombre is string && data.nombre.size() <= 200
        && data.precio is number && data.precio >= 0 && data.precio <= 1000000
        && data.variantes is list && data.variantes.size() <= 100;
    }

    // Opening a store: in the same batch that creates the owner's profile
    // as its admin (checked below).
    function isOpeningOwnStore(tiendaId, data) {
      return signedIn()
        && data.rol == 'admin'
        && data.activo == true
        && !exists(storePath(tiendaId))
        && getAfter(storePath(tiendaId)).data.duenoUid == request.auth.uid;
    }

    // The owner of the app: the only account that may set or change a
    // store's license. REEMPLAZA este UID por el tuyo de Firebase Auth
    // (Authentication -> tu usuario -> User UID). Sin esto, nadie puede
    // renovar licencias y las tiendas se bloquearán al terminar su prueba.
    function esDuenoLicencias() {
      return signedIn()
        && request.auth.uid == 'REEMPLAZA_CON_TU_UID_DE_FIREBASE';
    }

    match /tiendas/{tiendaId} {
      allow read: if isMemberOf(tiendaId) || esDuenoLicencias();
      // Al crear la tienda, el dueño de la tienda solo puede darse una
      // licencia de prueba corta (14 días); extenderla es exclusivo del
      // dueño de la app.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(
            ['nombre', 'duenoUid', 'creada', 'licenciaHasta'])
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() <= 120
        && request.resource.data.duenoUid == request.auth.uid
        && request.resource.data.licenciaHasta is timestamp
        && request.resource.data.licenciaHasta
             <= request.time + duration.value(15, 'd')
        && getAfter(ownProfilePath()).data.tiendaId == tiendaId
        && getAfter(ownProfilePath()).data.rol == 'admin';
      // Solo el dueño de la app cambia la tienda (su licencia o su nombre).
      allow update: if esDuenoLicencias()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['licenciaHasta', 'nombre'])
        && (!('licenciaHasta' in request.resource.data)
            || request.resource.data.licenciaHasta is timestamp);
      allow delete: if false;

      match /prendas/{prendaId} {
        allow read: if isMemberOf(tiendaId);
        allow create: if isAdminOf(tiendaId)
          && isValidPrenda(prendaId, request.resource.data);
        allow delete: if isAdminOf(tiendaId);
        allow update: if isValidPrenda(prendaId, request.resource.data) && (
          isAdminOf(tiendaId) || (
          isMemberOf(tiendaId)
          // Employees: stock counts only. Name, price and the set of
          // variants stay as they are.
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['variantes', 'actualizado', 'codigoProveedor'])
          // The app writes the whole garment when a stock change syncs from
          // offline: a garment saved before supplier codes existed then
          // gains an empty codigoProveedor, which isn't a real change.
          && (!('codigoProveedor' in request.resource.data.diff(resource.data).affectedKeys())
              || (!('codigoProveedor' in resource.data)
                  && request.resource.data.codigoProveedor == ''))
          && request.resource.data.variantes.size() == resource.data.variantes.size()
        ));
      }

      // Append-only sales log: anyone on staff can record a sale, nobody
      // edits or removes one afterward (a mistake is corrected with a new
      // entry, not a rewrite of history).
      match /ventas/{ventaId} {
        allow read: if isMemberOf(tiendaId);
        allow create: if isMemberOf(tiendaId)
          && request.resource.data.keys().hasOnly(
              ['itemId', 'nombreItem', 'color', 'talla', 'cantidad', 'precioUnitario', 'fecha', 'creado'])
          && request.resource.data.itemId is string
          && request.resource.data.nombreItem is string
          && request.resource.data.cantidad is int && request.resource.data.cantidad > 0
          && request.resource.data.precioUnitario is number && request.resource.data.precioUnitario >= 0;
        allow update, delete: if false;
      }

      // Append-only stock-adjustment history: anyone on staff can record one
      // (quick stock edit or full form), nobody edits or removes it
      // afterward — same reasoning as ventas above.
      match /ajustes/{ajusteId} {
        allow read: if isMemberOf(tiendaId);
        allow create: if isMemberOf(tiendaId)
          && request.resource.data.keys().hasOnly(
              ['itemId', 'nombreItem', 'color', 'talla', 'delta', 'usuarioNombre', 'fecha', 'creado'])
          && request.resource.data.itemId is string
          && request.resource.data.nombreItem is string
          && request.resource.data.usuarioNombre is string
          // Must be the signer's own name: an append-only audit trail is
          // only worth anything if nobody can attribute an entry to someone
          // else.
          && request.resource.data.usuarioNombre == profile().nombre
          && request.resource.data.delta is int && request.resource.data.delta != 0;
        allow update, delete: if false;
      }
    }

    match /usuarios/{uid} {
      // Your own profile, or your store's staff if you're its admin.
      allow read: if signedIn() && (
        request.auth.uid == uid || isAdminOf(resource.data.tiendaId));

      allow create: if isValidProfile(request.resource.data) && (
        // An admin adding staff to their own store.
        isAdminOf(request.resource.data.tiendaId)
        // Or someone opening their own new store.
        || (request.auth.uid == uid
          && isOpeningOwnStore(request.resource.data.tiendaId, request.resource.data))
      );

      // Admins manage their store's staff, never themselves (so a store
      // can't lose its last admin by accident), and nobody changes store.
      allow update: if isAdminOf(resource.data.tiendaId)
        && request.auth.uid != uid
        && isValidProfile(request.resource.data)
        && request.resource.data.tiendaId == resource.data.tiendaId;

      allow delete: if false;
    }
  }
}
